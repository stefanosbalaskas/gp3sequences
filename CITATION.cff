url: "https://stefanosbalaskas.github.io/gp3sequences/"
keywords:
  - "categorical sequences"
  - "sequence analysis"
  - "contiguous motifs"
  - "scanpaths"
  - "hidden Markov models"
  - "transition networks"
  - "provenance"
